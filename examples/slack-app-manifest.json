{
  "display_information": {
    "name": "My AI Agent",
    "description": "AI-powered assistant with streaming responses",
    "background_color": "#4A154B",
    "long_description": "AI agent built with n8n using native Slack streaming API. See answers as they are generated token by token in real time — no edited label, no waiting. Supports tool calling and memory."
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "My AI Agent",
      "always_online": true
    },
    "assistant_view": {
      "assistant_description": "Ask me anything — I can search, calculate, and answer questions.",
      "suggested_prompts": []
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "assistant:write",
        "channels:history",
        "chat:write",
        "im:history"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://your-n8n-domain.example.com/webhook/slack-events",
      "bot_events": [
        "app_mention",
        "assistant_thread_context_changed",
        "assistant_thread_started",
        "message.channels",
        "message.im"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://your-n8n-domain.example.com/webhook/slack-interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
