{
  "name": "Slack AI Streaming Agent - Template",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "slack-events",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "a1b2c3d4-0000-4000-8000-000000000000"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ challenge: $json.body?.challenge ?? '' }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "a1b2c3d4-2222-4000-8000-000000000002",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [220, 300],
      "notesInFlow": true,
      "notes": "Slack に即座に 200 を返す（3秒制限対策）。\nワークフローはこの後も継続実行される。"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "version": 2 },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $('Webhook').item.json.body.type }}",
                    "rightValue": "url_verification",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": "URL Verification"
            },
            {
              "conditions": {
                "options": { "version": 2 },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $('Webhook').item.json.body.event?.type }}",
                    "rightValue": "assistant_thread_started",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": "Thread Started"
            },
            {
              "conditions": {
                "options": { "version": 2 },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $('Webhook').item.json.body.event?.type }}",
                    "rightValue": "app_mention",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": "App Mention"
            },
            {
              "conditions": {
                "options": { "version": 2 },
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $('Webhook').item.json.body.event?.type }}",
                    "rightValue": "message",
                    "operator": { "type": "string", "operation": "equals" }
                  },
                  {
                    "leftValue": "={{ $('Webhook').item.json.body.event?.bot_id }}",
                    "rightValue": "",
                    "operator": { "type": "string", "operation": "empty" }
                  }
                ]
              },
              "renameOutput": "User Message (DM)"
            }
          ]
        },
        "options": {
          "fallbackOutput": "none"
        }
      },
      "id": "a1b2c3d4-3333-4000-8000-000000000003",
      "name": "Route by Event",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/assistant.threads.setSuggestedPrompts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  channel_id: $('Webhook').item.json.body.event.assistant_thread.channel_id,\n  thread_ts: $('Webhook').item.json.body.event.assistant_thread.thread_ts,\n  prompts: [\n    { title: \"Summarize\", message: \"Summarize the key points of this conversation.\" },\n    { title: \"Help me write\", message: \"Help me draft a message about...\" },\n    { title: \"What can you do?\", message: \"What kinds of tasks can you help me with?\" }\n  ]\n}) }}",
        "options": {}
      },
      "id": "a1b2c3d4-4444-4000-8000-000000000004",
      "name": "Set Suggested Prompts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1b2c3d4-aaaa-4000-8000-00000000000a",
              "name": "channel",
              "value": "={{ $('Webhook').item.json.body.event.channel }}",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-bbbb-4000-8000-00000000000b",
              "name": "thread_ts",
              "value": "={{ $('Webhook').item.json.body.event.thread_ts ?? $('Webhook').item.json.body.event.ts }}",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-cccc-4000-8000-00000000000c",
              "name": "user_id",
              "value": "={{ $('Webhook').item.json.body.event.user }}",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-dddd-4000-8000-00000000000d",
              "name": "team_id",
              "value": "={{ $('Webhook').item.json.body.team_id }}",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-eeee-4000-8000-00000000000e",
              "name": "chatInput",
              "value": "={{ ($('Webhook').item.json.body.event.text ?? '').replace(/<@[A-Z0-9]+>/g, '').trim() }}",
              "type": "string"
            },
            {
              "id": "a1b2c3d4-ffff-4000-8000-00000000000f",
              "name": "sessionId",
              "value": "={{ $('Webhook').item.json.body.event.channel }}_{{ $('Webhook').item.json.body.event.thread_ts ?? $('Webhook').item.json.body.event.ts }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-5555-4000-8000-000000000005",
      "name": "Extract Event Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 400]
    },
    {
      "parameters": {
        "channelId": "={{ $json.channel }}",
        "threadTs": "={{ $json.thread_ts }}",
        "recipientUserId": "={{ $json.user_id }}",
        "recipientTeamId": "={{ $json.team_id }}",
        "promptSource": "takePreviousNode",
        "systemPrompt": "You are a helpful AI assistant. Answer questions clearly and concisely.",
        "options": {
          "taskDisplayMode": "timeline",
          "maxIterations": 10,
          "feedbackButtons": true,
          "setThreadTitle": true
        }
      },
      "id": "a1b2c3d4-6666-4000-8000-000000000006",
      "name": "Slack AI Streaming Agent",
      "type": "n8n-nodes-slack-ai-streaming-agent.slackAiStreamingAgent",
      "typeVersion": 1,
      "position": [980, 400]
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-7777-4000-8000-000000000007",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [900, 620]
    },
    {
      "parameters": {
        "contextWindowLength": 20
      },
      "id": "a1b2c3d4-8888-4000-8000-000000000008",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [1080, 620]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          { "node": "Respond 200", "type": "main", "index": 0 }
        ]
      ]
    },
    "Respond 200": {
      "main": [
        [
          { "node": "Route by Event", "type": "main", "index": 0 }
        ]
      ]
    },
    "Route by Event": {
      "main": [
        [],
        [
          { "node": "Set Suggested Prompts", "type": "main", "index": 0 }
        ],
        [
          { "node": "Extract Event Data", "type": "main", "index": 0 }
        ],
        [
          { "node": "Extract Event Data", "type": "main", "index": 0 }
        ]
      ]
    },
    "Extract Event Data": {
      "main": [
        [
          { "node": "Slack AI Streaming Agent", "type": "main", "index": 0 }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          { "node": "Slack AI Streaming Agent", "type": "ai_languageModel", "index": 0 }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          { "node": "Slack AI Streaming Agent", "type": "ai_memory", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
